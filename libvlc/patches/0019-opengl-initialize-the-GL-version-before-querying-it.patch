From 104362b9eb4401b229ff4a1cbd1bfb2d2bdfac04 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 01:22:32 +0900
Subject: [PATCH 19/21] opengl: initialize the GL version before querying it

GL_MAJOR_VERSION is not supported before OpenGL 3.0 and OpenGL ES 3.0,
so glGetIntegerv() raises GL_INVALID_ENUM and leaves the value
uninitialized on the legacy OpenGL 2.1 context of macOS. A garbage
version above 3 made VLC load the real vertex array functions instead of
the stubs, and glGenVertexArrays() then failed with
GL_INVALID_OPERATION, which aborts playback in debug builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modules/video_output/opengl/gl_api.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/modules/video_output/opengl/gl_api.c b/modules/video_output/opengl/gl_api.c
index d0d391dc21..ec70c8444f 100644
--- a/modules/video_output/opengl/gl_api.c
+++ b/modules/video_output/opengl/gl_api.c
@@ -177,7 +177,10 @@ vlc_gl_api_Init(struct vlc_gl_api *api, vlc_gl_t *gl)
     GET_PROC_ADDR_OPTIONAL(ClientWaitSync);
 
     GL_ASSERT_NOERROR(&api->vt);
-    GLint version;
+    /* GL_MAJOR_VERSION only exists since OpenGL 3.0 and OpenGL ES 3.0, so the
+     * query fails and leaves the value untouched on older contexts, such as
+     * the legacy OpenGL 2.1 context on macOS. */
+    GLint version = 0;
     GLchar *glsl_version;
     api->vt.GetIntegerv(GL_MAJOR_VERSION, &version);
     glsl_version = (GLchar *) api->vt.GetString(GL_SHADING_LANGUAGE_VERSION);
