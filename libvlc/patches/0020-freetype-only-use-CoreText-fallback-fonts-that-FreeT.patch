+/* FreeType can not render every font CoreText can, such as PingFang on iOS 27,
+ * which only has 'hvgl' outlines */
+static bool IsFontRenderable(CTFontRef font)
+{
+    CFArrayRef tables = CTFontCopyAvailableTables(font, kCTFontTableOptionNoOptions);
+    if (tables == NULL)
+        return false;
+
+    bool renderable = false;
+    for (CFIndex i = 0; i < CFArrayGetCount(tables) && !renderable; i++) {
+        /* The array holds the tags themselves, not CFNumbers */
+        const void *value = CFArrayGetValueAtIndex(tables, i);
+        CTFontTableTag tag = (CTFontTableTag)(uintptr_t)value;
+        switch (tag) {
+            case kCTFontTableGlyf:
+            case kCTFontTableCFF:
+            case kCTFontTableCFF2:
+            case kCTFontTableSbix:
+            case kCTFontTableCBDT:
+                renderable = true;
+                break;
+        }
+    }
+    CFRelease(tables);
+    return renderable;
+}
+
+static bool FontHasCodepoint(CTFontRef font, uni_char_t codepoint)
+{
+    UniChar characters[2];
+    CGGlyph glyphs[2];
+    CFIndex count = CFStringGetSurrogatePairForLongCharacter(codepoint, characters) ? 2 : 1;
+    return CTFontGetGlyphsForCharacters(font, characters, glyphs, count);
+}
+
+/* Returns the first font of the descriptors that has the codepoint and that FreeType can render */
+static CTFontRef CreateRenderableFontFromDescriptors(CFArrayRef descriptors, uni_char_t codepoint)
+{
+    for (CFIndex i = 0; i < CFArrayGetCount(descriptors); i++) {
+        CTFontDescriptorRef descriptor = CFArrayGetValueAtIndex(descriptors, i);
+        CTFontRef font = CTFontCreateWithFontDescriptor(descriptor, 0., NULL);
+        if (font == NULL)
+            continue;
+        if (FontHasCodepoint(font, codepoint) && IsFontRenderable(font))
+            return font;
+        CFRelease(font);
+    }
+    return NULL;
+}
+
+static CTFontRef CreateRenderableFallbackFont(CTFontRef font, CFStringRef codepointString,
+                                              uni_char_t codepoint)
+{
+    CTFontRef fallbackFont = CTFontCreateForString(font, codepointString,
+                                                   CFRangeMake(0, CFStringGetLength(codepointString)));
+    if (fallbackFont == NULL || IsFontRenderable(fallbackFont))
+        return fallbackFont;
+    CFRelease(fallbackFont);
+    fallbackFont = NULL;
+
+    /* Try the other fonts CoreText uses for the languages of the user */
+    CFArrayRef cascadeList = CTFontCopyDefaultCascadeListForLanguages(font, NULL);
+    if (cascadeList != NULL) {
+        fallbackFont = CreateRenderableFontFromDescriptors(cascadeList, codepoint);
+        CFRelease(cascadeList);
+        if (fallbackFont != NULL)
+            return fallbackFont;
+    }
+
+    /* Then any font with the codepoint, such as the fonts activated by the application */
+    CFCharacterSetRef characterSet = CFCharacterSetCreateWithCharactersInString(kCFAllocatorDefault,
+                                                                                codepointString);
+    if (characterSet == NULL)
+        return NULL;
+    CFDictionaryRef attributes = CFDictionaryCreate(kCFAllocatorDefault,
+                                                    (const void **)&kCTFontCharacterSetAttribute,
+                                                    (const void **)&characterSet, 1,
+                                                    &kCFTypeDictionaryKeyCallBacks,
+                                                    &kCFTypeDictionaryValueCallBacks);
+    CTFontDescriptorRef descriptor = CTFontDescriptorCreateWithAttributes(attributes);
+    CFArrayRef matches = CTFontDescriptorCreateMatchingFontDescriptors(descriptor, NULL);
+    if (matches != NULL) {
+        CFMutableArrayRef sortedMatches = CFArrayCreateMutableCopy(kCFAllocatorDefault, 0, matches);
+        CFArraySortValues(sortedMatches, CFRangeMake(0, CFArrayGetCount(sortedMatches)),
+                          (CFComparatorFunction)SortCTFontMatchResults, NULL);
+        fallbackFont = CreateRenderableFontFromDescriptors(sortedMatches, codepoint);
+        CFRelease(sortedMatches);
+        CFRelease(matches);
+    }
+    CFRelease(descriptor);
+    CFRelease(attributes);
+    CFRelease(characterSet);
+    return fallbackFont;
+}
+
+static bool IsMissingCodepoint(vlc_font_select_t *fs, uni_char_t codepoint)
+{
+    uni_char_t missing;
+    vlc_vector_foreach(missing, &fs->missing_codepoints) {
+        if (missing == codepoint)
+            return true;
+    }
+    return false;
+}
