index acc8570f69..ee9f82cc44 100644
--- a/lib/media.c
+++ b/lib/media.c
@@ -229,6 +229,9 @@ static void media_destroy( void *libvlc_owner )
 
     media_cookies_clear( p_md );
 
+    if( p_md->p_header_jar )
+        vlc_http_headers_destroy( p_md->p_header_jar );
+
     free( p_md );
 }
 
@@ -274,6 +277,7 @@ libvlc_media_t * libvlc_media_new_from_input_item(input_item_t *p_input_item )
     p_md->req = NULL;
     p_md->p_cookies = NULL;
     p_md->i_cookies = 0;
+    p_md->p_header_jar = NULL;
 
     input_item_Hold( p_md->p_input_item );
 
@@ -887,3 +891,42 @@ libvlc_media_cookies_replay( libvlc_media_t *p_md,
                                 p_md->p_cookies[i].psz_host,
                                 p_md->p_cookies[i].psz_path );
 }
+
+int
+libvlc_media_header_jar_store( libvlc_media_t *p_md,
+                               const char *psz_name, const char *psz_value )
+{
+    if( !p_md->p_header_jar )
+    {
+        p_md->p_header_jar = vlc_http_headers_new();
+        if( !p_md->p_header_jar )
+            return -1;
+    }
+    return vlc_http_headers_store( p_md->p_header_jar, psz_name, psz_value ) ? 0 : -1;
+}
+
+void
+libvlc_media_header_jar_clear( libvlc_media_t *p_md )
+{
+    if( p_md->p_header_jar )
+        vlc_http_headers_clear( p_md->p_header_jar );
+}
+
+static int
+media_header_replay_cb( void *opaque, const char *psz_name,
+                        const char *psz_value )
+{
+    vlc_http_header_jar_t *p_jar = opaque;
+    vlc_http_headers_store( p_jar, psz_name, psz_value );
+    return 0;
+}
+
+void
+libvlc_media_headers_replay( libvlc_media_t *p_md,
+                             vlc_http_header_jar_t *p_jar )
+{
+    vlc_http_headers_clear( p_jar );
+    if( p_md->p_header_jar )
+        vlc_http_headers_foreach( p_md->p_header_jar,
+                                  media_header_replay_cb, p_jar );
+}
