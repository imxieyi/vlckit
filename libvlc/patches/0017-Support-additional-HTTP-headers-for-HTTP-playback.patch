 };
 
 /* Replay the cookies stored on p_md into p_jar. */
 void libvlc_media_cookies_replay( libvlc_media_t *p_md,
                                   vlc_http_cookie_jar_t *p_jar );
 
+/* Replace the content of p_jar with the headers stored on p_md. */
+void libvlc_media_headers_replay( libvlc_media_t *p_md,
+                                  vlc_http_header_jar_t *p_jar );
+
 /* Media Descriptor */
 libvlc_media_t * libvlc_media_new_from_input_item( input_item_t * );
 
diff --git a/lib/media_player.c b/lib/media_player.c
index 3fffa9145a..98bcc8c187 100644
--- a/lib/media_player.c
+++ b/lib/media_player.c
@@ -1056,6 +1056,17 @@ int libvlc_media_player_play( libvlc_media_player_t *p_mi )
 
         if( p_md != NULL && p_jar != NULL )
             libvlc_media_cookies_replay( p_md, p_jar );
+
+        /* Same for the additional HTTP headers, which replace the ones of
+         * the previously played media. */
+        vlc_http_header_jar_t *p_header_jar = vlc_player_GetHeaderJar( player );
+        if( p_header_jar != NULL )
+        {
+            if( p_md != NULL )
+                libvlc_media_headers_replay( p_md, p_header_jar );
+            else
+                vlc_http_headers_clear( p_header_jar );
+        }
     }
 
     int ret = vlc_player_Start(player);
