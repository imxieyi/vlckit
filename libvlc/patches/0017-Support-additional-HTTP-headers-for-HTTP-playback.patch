index 7b702ca6a7..c533f554ac 100644
--- a/lib/libvlc.sym
+++ b/lib/libvlc.sym
@@ -223,6 +223,8 @@ libvlc_media_get_meta_extra_names
 libvlc_media_meta_extra_names_release
 libvlc_media_cookie_jar_store
